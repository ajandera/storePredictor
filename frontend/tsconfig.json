{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "verbatimModuleSyntax": false,
    "strict": false,
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"],
      "nuxt-property-decorator": ["./compat/nuxt-property-decorator.ts"],
      "vuex-class": ["./compat/vuex-class.ts"]
    }
  }
}
